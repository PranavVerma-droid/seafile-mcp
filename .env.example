# Seafile MCP Server Configuration
# Copy this file to .env and fill in your values

# Your Seafile server URL (no trailing slash)
# Example: https://cloud.seafile.com or https://files.example.com
SEAFILE_URL=https://your-seafile-server.com

# --- Local mode (stdio) ---------------------------------------------------
# Your Seafile API token. Only used in stdio mode.
# In http mode this is ignored: each client sends its own token as
# "Authorization: Bearer <token>".
SEAFILE_TOKEN=your-api-token-here

# --- Hosted mode (http) ---------------------------------------------------
# Transport: "stdio" (local, default) or "http" (hosted)
# MCP_TRANSPORT=stdio

# Bind address and port for http mode
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Comma-separated public hostnames the server is reached at. Enables
# Host/Origin checks (DNS rebinding protection). Recommended in production.
# MCP_ALLOWED_HOSTS=files-mcp.example.com
